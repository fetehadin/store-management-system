datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

// DOMAIN ENUMS

enum Role {
  ADMIN
  SALES_REP
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditEntity {
  ADMIN_STORE
  SALES_REP
  SUPPLIER
  DIRECT_BUYER
}

enum IssuanceStatus {
  ISSUED
  RETURNED
  PARTIAL_RETURNED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnDestination {
  WAREHOUSE
  SUPPLIER
}

//CORE ENTITIES (USERS, SUPPLIERS, PRODUCTS, BANKS)

model User {
  id                     String   @id @default(uuid()) 
  fullName               String  
  username               String   @unique 
  passwordHash           String
  profilePic             String?  // <--- ADDED: To display avatars on the Agents screen
  role                   Role     @default(SALES_REP)
  requiresPasswordChange Boolean  @default(false) 
  
  isActive               Boolean  @default(true) 

  creditLimit            Decimal  @default("0.00") @db.Decimal(12, 2)
  creditBalance          Decimal  @default("0.00") @db.Decimal(12, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  stockIssusances        StockIssuance[]
  paymentProofs          PaymentProof[]
  sales                  Sale[]
  returns                StockReturn[]
}

model Supplier {
  id                String  @id @default(uuid()) 
  name               String  
  phone              String  @unique
  creditBalance      Decimal   @default("0.00") @db.Decimal(12, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  batches            InventoryBatch[]
}

model Product {
  id                String  @id @default(uuid()) 
  name              String  
  description       String?
  category          String?   // <--- ADDED: To power the horizontal category filter
  imageUrl          String?   // <--- ADDED: To display product images
  price             Decimal   @db.Decimal(12, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  batches           InventoryBatch[]
  sales             Sale[]
}

model Retailer {
  id                String           @id @default(uuid())
  name              String
  phone             String?          @unique
  address           String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  sales             Sale[]
}

// ----------------------------------------------------
// NEW: SUPPORTED BANKS (For Admin Dropdown Management)
// ----------------------------------------------------
model SupportedBank {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "Commercial Bank of Ethiopia (CBE)"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// FIFO INVENTORY BATCHES

model InventoryBatch {
  id                    String       @id @default(uuid())
  batchCode             String       @unique
  productId             String
  product               Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplierId            String
  supplier              Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  quantityRecieved      Int
  remainingQty          Int
  unitCostPrice         Decimal      @db.Decimal(12, 2)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Composite index: instant lookup for olders sellable batches during FIFO checkout
  @@index([productId, remainingQty, createdAt])
}

// STOCK ISSUANCE (MODEL B WHOLESALE CHECKOUT)
model StockIssuance {
  id                    String       @id @default(uuid())
  userId                String
  user                  User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  status                IssuanceStatus @default(ISSUED)
  totalWholesaleValue   Decimal      @db.Decimal(12, 2)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  items                 IssuanceItem[]
}

model IssuanceItem {
  id             String        @id @default(uuid())
  issuanceId     String
  issuance       StockIssuance @relation(fields: [issuanceId], references: [id], onDelete: Cascade)
  productId      String
  wholesalePrice Decimal       @db.Decimal(12, 2)
  qtyIssued      Int
  qtyRemaining   Int           
  cogsCalculated Decimal       @db.Decimal(12, 2) 
}

// RETAIL SALES TRACKING

model Sale {
  id            String   @id @default(uuid())
  salesRepId    String
  salesRep      User     @relation(fields: [salesRepId], references: [id], onDelete: Restrict)
  retailerId    String
  retailer      Retailer @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int
  totalAmount   Decimal  @db.Decimal(12, 2)
  paymentMethod String   
  createdAt     DateTime @default(now())
}

model PaymentProof{
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  //3-layer anti-duplicatoin security shield(DB-level unique constraint)
  transactionRedId String      @unique
  sha256Hash       String      @unique
  amount           Decimal     @db.Decimal(12, 2)
  bankName         String      // <--- ADDED THIS FOR THE DROPDOWN / "OTHER" SUPPORT
  senderName       String?
  reasonRemark     String?
  receipeImageUrl  String?
  status           ProofStatus @default(PENDING)
  adminRemark      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, createdAt])
}

// 6. IMMUTABLE FINANCIAL AUDIT LEDGER

model LedgerEntry {
  id               String       @id @default(uuid())
  transactionDate  DateTime     @default(now())
  fromEntity       AuditEntity
  fromEntityId     String?
  toEntity         AuditEntity
  toEntityId       String?
  amount           Decimal      @db.Decimal(12, 2)
  transferMethod   String       // e.g., CBE_BANK, TELEBIRR, CASH, CREDIT_ADJUSTMENT
  receiptUrl       String?
  auditRemark      String?      // Mandatory in app logic if receiptUrl is null
  transactionRefId String?      @unique
  createdAt        DateTime     @default(now())

  @@index([fromEntity, toEntity, transactionDate])
}


model StockReturn {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  totalValue  Decimal
  reason      String
  status      ReturnStatus      @default(PENDING)
  destination ReturnDestination?
  items       ReturnItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ReturnItem {
  id            String      @id @default(uuid())
  stockReturnId String
  stockReturn   StockReturn @relation(fields: [stockReturnId], references: [id])
  itemId        String      // References your Inventory Item ID
  quantity      Int
}