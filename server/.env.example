# Application Runtime
NODE_ENV="development"
PORT="5000"

# Strict CORS policy (Never use "*" in production)
CORS_ORIGIN="http://localhost:3000"

# Security Secrets (Must be at least 32 characters long)
JWT_SECRET="replace_this_with_a_super_long_random_secret_key_32chars"

# Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/b2b_distro_db?schema=public"